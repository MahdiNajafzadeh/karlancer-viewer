{
  "name": "karlancer-evaluator",
  "version": "2.0.0",
  "private": true,
  "workspaces": [],
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "start": "bun run src/index.ts",
    "restart": "bun run build:web && bun run start"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
